# DigitalStarCharter environment variables
# Copy this file to .env for local development and replace placeholders with real values.
# Never commit real secrets.

# Primary Neon/Postgres connection string used by the Charter Operating System.
NEON_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Optional compatibility fallback for older code and tooling.
# Leave blank if NEON_DATABASE_URL is set.
DATABASE_URL=

# Human-in-the-loop administrator email.
ADMIN=admin@example.com

# Required for secure Express sessions. Generate a long random value for production.
SESSION_SECRET=replace-with-a-long-random-secret

# Runtime mode. Usually set automatically by hosting platforms.
NODE_ENV=development
