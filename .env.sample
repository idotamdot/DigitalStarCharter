# DigitalStarCharter environment variables
# Copy this file to .env.local for local development and replace placeholders with real values.
# Never commit real secrets.

# Primary Neon/Postgres connection string used by the Charter Operating System.
NEON_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Optional compatibility fallback for older code and tooling.
# Leave blank if NEON_DATABASE_URL is set.
DATABASE_URL=

# Neon Auth endpoint used by server-side identity validation.
AUTH_URL=https://YOUR-NEON-AUTH-ENDPOINT

# Neon Auth JSON Web Key Set endpoint used to verify JWT signatures.
JWKS_URL=https://YOUR-NEON-AUTH-ENDPOINT/.well-known/jwks.json

# Browser-safe Neon Auth endpoint exposed through Vite.
# This should point to the same Neon Auth service as AUTH_URL.
VITE_NEON_AUTH_URL=https://YOUR-NEON-AUTH-ENDPOINT

# Human-in-the-loop administrator email. A verified Neon identity matching this
# address receives the administrator capability set.
ADMIN=admin@example.com

# Runtime mode. Usually set automatically by hosting platforms.
NODE_ENV=development
